+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  HotkeyManager,
+  HotkeyRecorder,
+  KeyStateTracker,
+  detectPlatform,
+  domEnvironment,
+  findHotkeyConflicts,
+  getHotkeysEnvironment,
+  setHotkeysEnvironment,
+} from '../src'
+import type { HotkeysEnvironment, Target } from '../src'
+
+type Listener = { listener: EventListener; capture: boolean }
+
+/** A host without a DOM: one root that receives every key, and a text-field flag. */
+function createHost() {
+  const root = { name: 'root' } as unknown as Target
+  const listeners = new Map<string, Array<Listener>>()
+  let typing = false
+  let current: unknown = null
+
+  const event = (type: string, init: KeyboardEventInit) => {
+    let stopped = false
+    const keyEvent = {
+      type,
+      key: init.key ?? '',
+      code: init.code ?? '',
+      ctrlKey: !!init.ctrlKey,
+      shiftKey: !!init.shiftKey,
+      altKey: !!init.altKey,
+      metaKey: !!init.metaKey,
+      repeat: !!init.repeat,
+      location: 0,
+      isComposing: false,
+      isTrusted: true,
+      defaultPrevented: false,
+      get currentTarget() {
+        return current
+      },
+      getModifierState: () => false,
+      composedPath: () => [root],
+      preventDefault() {
+        keyEvent.defaultPrevented = true
+      },
+      stopPropagation() {
+        stopped = true
+      },
+      get stopped() {
+        return stopped
+      },
+    }
+    return keyEvent as unknown as KeyboardEvent & { stopped: boolean }
+  }
+
+  const environment: HotkeysEnvironment = {
+    defaultTarget: () => root,
+    globalTarget: () => root,
+    listen(target, type, listener, capture) {
+      expect(target).toBe(root)
+      const list = listeners.get(type) ?? []
+      const entry = { listener, capture }
+      list.push(entry)
+      listeners.set(type, list)
+      return () => list.splice(list.indexOf(entry), 1)
+    },
+    detectPlatform: () => 'mac',
+    isEventForTarget: (_event, target) => target === root,
+    eventReachesTarget: (_event, target) => target === root,
+    shouldIgnoreInputEvent: () => typing,
+    isTypingEvent: () => typing,
+    targetsOverlap: () => true,
+    createKeyboardEvent: (type, init) => event(type, init),
+  }
+
+  return {
+    root,
+    environment,
+    listenerCount: () =>
+      [...listeners.values()].reduce((sum, list) => sum + list.length, 0),
+    setTyping(value: boolean) {
+      typing = value
+    },
+    press(type: 'keydown' | 'keyup', init: KeyboardEventInit) {
+      const keyEvent = event(type, init)
+      const list = [...(listeners.get(type) ?? [])]
+      // Capture listeners first, then bubble, as on a single root
+      for (const capture of [true, false]) {
+        for (const entry of list.filter((l) => l.capture === capture)) {
+          current = root
+          entry.listener(keyEvent)
+          if (keyEvent.stopped) return keyEvent
+        }
+      }
+      current = null
+      return keyEvent
+    },
+    blur() {
+      for (const entry of listeners.get('blur') ?? []) {
+        entry.listener({ type: 'blur' } as Event)
+      }
+    },
+  }
+}
+
+describe('HotkeysEnvironment', () => {
+  afterEach(() => {
+    HotkeyManager.resetInstance()
+    KeyStateTracker.resetInstance()
+    setHotkeysEnvironment(null)
+  })
+
+  it('defaults to the DOM environment and restores it with null', () => {
+    expect(getHotkeysEnvironment()).toBe(domEnvironment)
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    expect(getHotkeysEnvironment()).toBe(host.environment)
+    setHotkeysEnvironment(null)
+    expect(getHotkeysEnvironment()).toBe(domEnvironment)
+  })
+
+  it('reads the platform from the environment', () => {
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    expect(detectPlatform()).toBe('mac')
+  })
+
+  it('registers on the default target and dispatches host events', () => {
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    const callback = vi.fn()
+    const handle = HotkeyManager.getInstance().register('Mod+S', callback)
+
+    expect(handle.isActive).toBe(true)
+    const event = host.press('keydown', {
+      key: 's',
+      code: 'KeyS',
+      metaKey: true,
+    })
+    expect(callback).toHaveBeenCalledTimes(1)
+    expect(event.defaultPrevented).toBe(true)
+
+    handle.unregister()
+    expect(host.listenerCount()).toBe(0)
+  })
+
+  it('asks the environment whether to ignore text input', () => {
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    const callback = vi.fn()
+    HotkeyManager.getInstance().register('K', callback)
+
+    host.setTyping(true)
+    host.press('keydown', { key: 'k', code: 'KeyK' })
+    expect(callback).not.toHaveBeenCalled()
+
+    host.setTyping(false)
+    host.press('keydown', { key: 'k', code: 'KeyK' })
+    expect(callback).toHaveBeenCalledTimes(1)
+  })
+
+  it('runs sequences through the environment', () => {
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    const callback = vi.fn()
+    HotkeyManager.getInstance().register(['G', 'G'], callback)
+
+    host.press('keydown', { key: 'g', code: 'KeyG' })
+    host.press('keyup', { key: 'g', code: 'KeyG' })
+    host.press('keydown', { key: 'g', code: 'KeyG' })
+    expect(callback).toHaveBeenCalledTimes(1)
+  })
+
+  it('tracks held keys on the global target and clears them on blur', () => {
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    const tracker = KeyStateTracker.getInstance()
+
+    host.press('keydown', { key: 'Shift', code: 'ShiftLeft', shiftKey: true })
+    expect(tracker.getHeldKeys()).toEqual(['Shift'])
+    host.blur()
+    expect(tracker.getHeldKeys()).toEqual([])
+  })
+
+  it('records through the environment and suppresses hotkeys meanwhile', () => {
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    const callback = vi.fn()
+    const onRecord = vi.fn()
+    HotkeyManager.getInstance().register('Mod+K', callback)
+    const recorder = new HotkeyRecorder({ onRecord })
+
+    recorder.start()
+    host.press('keydown', { key: 'k', code: 'KeyK', metaKey: true })
+    expect(onRecord).toHaveBeenCalledWith('Mod+[KeyK]')
+    expect(callback).not.toHaveBeenCalled()
+    recorder.destroy()
+  })
+
+  it('creates synthetic events with the environment', () => {
+    const host = createHost()
+    const createKeyboardEvent = vi.spyOn(
+      host.environment,
+      'createKeyboardEvent',
+    )
+    setHotkeysEnvironment(host.environment)
+    const callback = vi.fn()
+    const manager = HotkeyManager.getInstance()
+    const { id } = manager.register('Mod+S', callback)
+
+    expect(manager.triggerRegistration(id)).toBe(true)
+    expect(createKeyboardEvent).toHaveBeenCalledWith(
+      'keydown',
+      expect.objectContaining({ key: 'S', metaKey: true }),
+    )
+    expect(callback).toHaveBeenCalledTimes(1)
+  })
+
+  it('checks conflicts against the default target', () => {
+    const host = createHost()
+    setHotkeysEnvironment(host.environment)
+    HotkeyManager.getInstance().register('Mod+S', vi.fn())
+    expect(findHotkeyConflicts('Mod+S')).toHaveLength(1)
+  })
+
+  it('leaves hotkeys inert when the environment has no default target', () => {
+    setHotkeysEnvironment({
+      ...domEnvironment,
+      defaultTarget: () => undefined,
+    })
+    const handle = HotkeyManager.getInstance().register('Mod+S', vi.fn())
+    expect(handle.isActive).toBe(false)
+  })
+})
